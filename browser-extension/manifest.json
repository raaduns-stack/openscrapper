{
  "manifest_version": 3,
  "name": "Scrappee Browser Import",
  "version": "0.6.8",
  "description": "Automatic Google/Bing SERP collection for Scrappee using the stable extractor.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "alarms"],
  "host_permissions": ["https://api.scrapee.uk/*"],
  "background": {"service_worker": "service-worker.js"},
  "action": {"default_title": "Scrappee SERP Capture", "default_popup": "popup.html"}
}
