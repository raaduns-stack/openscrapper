const API='https://api.scrapee.uk';
const KEY='harvestedResults';
const PAGE_KEY='capturedSerpPages';
const AUTH_KEY='scrappeeAuth';
const SYNCED_KEY='syncedCaptureIds';
const $=id=>document.getElementById(id);

async function getAuth(){const v=await chrome.storage.local.get(AUTH_KEY);if(v[AUTH_KEY]?.token)return v[AUTH_KEY];try{const r=await chrome.runtime.sendMessage({type:'auth_get'});if(r?.auth?.token){await chrome.storage.local.set({[AUTH_KEY]:r.auth});return r.auth;}}catch(_){}return null;}
async function api(path,options={}){const auth=await getAuth();const headers={'Content-Type':'application/json',...(options.headers||{})};if(auth?.token)headers.Authorization=`Bearer ${auth.token}`;const r=await fetch(API+path,{...options,headers});const text=await r.text();let data={};try{data=text?JSON.parse(text):{}}catch(_){data={detail:text}}if(!r.ok)throw new Error(data.detail||`API error ${r.status}`);return data;}
async function getResults(){const v=await chrome.storage.local.get(KEY);return Array.isArray(v[KEY])?v[KEY]:[];}
async function getPages(){const v=await chrome.storage.local.get(PAGE_KEY);return Array.isArray(v[PAGE_KEY])?v[PAGE_KEY]:[];}
async function getSyncedIds(){const v=await chrome.storage.local.get(SYNCED_KEY);return new Set(Array.isArray(v[SYNCED_KEY])?v[SYNCED_KEY]:[]);}
function captureKey(r){return r.capture_id||`${r.url||''}\n${r.title||''}\n${r.snippet||''}\n${r.page_url||''}`;}
function renderResults(results){$('count').textContent=results.length;$('results').innerHTML=results.slice(-12).reverse().map(r=>`<div class="result"><b>${esc(r.title||r.url||'')}</b><span>${esc(r.url||'')}</span><span>${esc(r.snippet||'')}</span></div>`).join('');}
function esc(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function pageKey(url){try{const u=new URL(url);for(const k of [...u.searchParams.keys()])if(/^sca_|^sxsrf$|^ei$|^ved$|^uule$|^oq$|^sourceid$/i.test(k))u.searchParams.delete(k);return u.origin+u.pathname+'?'+u.searchParams.toString();}catch(_){return url||'';}}

async function loadCurrentScrap(){const scrap=await api('/scraps/current');if(!scrap){$('target').textContent='Current Scrap: none';return null;}$('target').textContent=`Current Scrap: ${scrap.name} — ${scrap.status}`;return scrap;}
async function showState(auth){if(!auth)auth=await getAuth();document.body.classList.remove('auth-pending');if(!auth?.token){$('loginView').classList.remove('hidden');$('appView').classList.add('hidden');return;}$('loginView').classList.add('hidden');$('appView').classList.remove('hidden');$('account').textContent=`Logged in as ${auth.email}`;try{await loadCurrentScrap();renderResults(await getResults());}catch(e){$('status').textContent=e.message;}}
$('login').addEventListener('click',async()=>{const email=$('email').value.trim(),password=$('password').value;if(!email||!password){$('loginStatus').textContent='Email and password are required.';return;}$('login').disabled=true;$('loginStatus').textContent='Logging in…';try{const data=await api('/auth/login',{method:'POST',headers:{'X-Scrappee-Extension':'1'},body:JSON.stringify({email,password})});await chrome.storage.local.set({[AUTH_KEY]:{email:data.email,token:data.token}});await chrome.runtime.sendMessage({type:'auth_set',auth:{email:data.email,token:data.token}});$('loginStatus').textContent='';await showState();}catch(e){$('loginStatus').textContent=e.message;}finally{$('login').disabled=false;}});
$('reloadScraps').addEventListener('click',async()=>{try{await loadCurrentScrap();$('status').textContent='Current Scrap refreshed.';}catch(e){$('status').textContent=e.message;}});
$('logout').addEventListener('click',async()=>{try{await api('/auth/logout',{method:'POST'});}catch(_){}await chrome.runtime.sendMessage({type:'auth_clear'});await chrome.storage.local.remove([AUTH_KEY]);await showState();});
chrome.storage.local.get([KEY],v=>renderResults(Array.isArray(v[KEY])?v[KEY]:[]));
(async()=>{try{const r=await chrome.runtime.sendMessage({type:'auth_validate'});if(r?.auth?.token){await chrome.storage.local.set({[AUTH_KEY]:r.auth});await showState(r.auth);return;}await showState(await getAuth());}catch(_){await showState(await getAuth());}})();
chrome.storage.onChanged.addListener((c,a)=>{if(a==='local'&&c[KEY])renderResults(c[KEY].newValue||[]);});
$('capture').addEventListener('click',async()=>{try{$('status').textContent='Capturing Google/Bing results…';const [tab]=await chrome.tabs.query({active:true,currentWindow:true});if(!tab?.id||!/https?:\/\//.test(tab.url||'')||!/google\.|bing\./i.test(new URL(tab.url).hostname))throw new Error('Open a Google or Bing SERP first.');const [{result}]=await chrome.scripting.executeScript({target:{tabId:tab.id},func:captureSerpPage});if(!result?.ok)throw new Error(result?.error||'SERP capture failed.');if(result.challenge)throw new Error('Search-engine challenge detected.');const current=await getResults(),pages=await getPages(),key=pageKey(tab.url);const existing=new Set(current.filter(r=>pageKey(r.page_url)===key).map(r=>`${r.url}\n${r.title||''}\n${r.snippet||''}`));const fresh=result.results.filter(r=>!existing.has(`${r.url}\n${r.title||''}\n${r.snippet||''}`));if(!fresh.length){$('status').textContent='This SERP page was already captured; no duplicates added.';return;}const tagged=fresh.map((r,i)=>({...r,capture_id:`${Date.now()}-${tab.id}-${i}`,captured_at:new Date().toISOString()}));const next=current.concat(tagged).slice(-10000);await chrome.storage.local.set({[KEY]:next,[PAGE_KEY]:Array.from(new Set(pages.concat(key))).slice(-2000)});await chrome.action.setBadgeText({text:String(Math.min(next.length,9999))});renderResults(next);$('status').textContent=`Captured ${tagged.length} new result occurrences. Total stored: ${next.length}.`;}catch(e){$('status').textContent=e.message||String(e);}});

async function captureSerpPage(){const host=location.hostname.toLowerCase(),google=host.includes('google'),text=(document.body?.innerText||'').toLowerCase();if(/\/sorry\//.test(location.href.toLowerCase())||/captcha|unusual traffic|verify you are human/.test(text))return{ok:false,challenge:true,error:'Search-engine challenge detected.'};const seen=new Set(),results=[];const scan=()=>{const selector=google?'div.MjjYud, div.tF2Cxc':'li.b_algo',cards=[...document.querySelectorAll(selector)],anchors=cards.length?cards.map(c=>c.querySelector('a[href]:has(h3),h2 a[href],h3 a[href]')).filter(Boolean):[...document.querySelectorAll('a[href]:has(h3),h2 a[href]')];for(const a of anchors){const card=a.closest(selector)||a;let u;try{u=new URL(a.href,location.href);}catch(_){continue;}if(!/^https?:$/.test(u.protocol)||/^(www\.)?(google|bing)\./i.test(u.hostname))continue;const title=(card.querySelector('h3,h2')?.innerText||a.innerText||'').trim(),snippet=(card.querySelector('.VwiC3b,[data-sncf],div.IsZvec,.kb0PBd,.yXK7lf,.b_caption p')?.innerText||'').trim(),key=`${u.href}\n${title}\n${snippet}`;if(seen.has(key))continue;seen.add(key);results.push({url:u.href,title,snippet,provider:google?'google':'bing',page_url:location.href});}};let stable=0,last=-1;for(let i=0;i<40;i++){const before=results.length;scan();const h=document.documentElement.scrollHeight,bottom=scrollY+innerHeight>=h-40;if(bottom&&results.length===before)stable++;else stable=0;if(bottom&&stable>=3)break;last=h;scrollTo(0,Math.min(h,scrollY+Math.max(500,Math.floor(innerHeight*.85))));await new Promise(r=>setTimeout(r,650));}scan();return{ok:true,results};}

$('sync').addEventListener('click',async()=>{try{const auth=await getAuth(),results=await getResults(),synced=await getSyncedIds();if(!auth?.token){showState();return;}if(!results.length)throw new Error('Nothing captured yet.');const pending=results.filter(r=>!synced.has(captureKey(r)));if(!pending.length){$('status').textContent='All captured results are already synced; no duplicates sent.';return;}const scrap=await loadCurrentScrap();if(!scrap)throw new Error('No active Current Scrap.');$('status').textContent=`Syncing ${pending.length} new occurrences to ${scrap.name}…`;const session=await api('/serp/sessions',{method:'POST',body:JSON.stringify({scrap_id:scrap.id,ttl_seconds:1800})});const chunk=12;let syncedNow=0;for(let i=0;i<pending.length;i+=chunk){const batch=pending.slice(i,i+chunk);await api('/serp/import',{method:'POST',body:JSON.stringify({token:session.token,urls:[],results:batch,page_url:batch[0]?.page_url||''})});for(const r of batch)synced.add(captureKey(r));await chrome.storage.local.set({[SYNCED_KEY]:Array.from(synced).slice(-20000)});syncedNow+=batch.length;}$('status').textContent=`Synced ${syncedNow} new occurrences to Scrappee.`;const tabs=await chrome.tabs.query({});for(const tab of tabs)if(/^https:\/\/(www\.)?scrapee\.uk\//i.test(tab.url||''))try{await chrome.tabs.reload(tab.id);}catch(_){} }catch(e){$('status').textContent=e.message||String(e);}});
